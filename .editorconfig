root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

# 大载荷与压缩块：任何格式化都会破坏惰性解码，编辑器请勿处理
[{src/assets/**,src/vendor/**}]
insert_final_newline = false
trim_trailing_whitespace = false

[*.{yml,yaml}]
indent_size = 2
